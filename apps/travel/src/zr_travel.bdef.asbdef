managed implementation in class zbp_r_travel unique;
strict ( 2 );
with draft;

define behavior for ZR_Travel alias Travel
persistent table ztravel_a
draft table ztravel_d
lock master
total etag LastChangedAt
authorization master ( instance )
etag master LocalLastChangedAt
{
  create;
  update ( features : instance );
  delete ( features : instance );
  association _Booking { create ( features : instance ); }

  field ( numbering : managed, readonly ) TravelUUID;
  field ( readonly ) TravelID, TotalPrice, OverallStatus, RejectReason,
                     CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;
  field ( mandatory ) CustomerID, BeginDate, EndDate;

  action ( features : instance ) acceptTravel result [1] $self;
  action ( features : instance ) rejectTravel parameter ZA_RejectReason result [1] $self;
  internal action reCalcTotalPrice;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation validateCustomer;
    validation validateDates;
    validation Booking~validateFlightDate;
  }

  determination setStatusToOpen   on modify { create; }
  determination calculateTotal    on modify { create; field BookingFee, CurrencyCode; }
  determination calculateTravelID on save   { create; }

  side effects
  {
    field BookingFee affects field TotalPrice;
    field CurrencyCode affects field TotalPrice;
    action acceptTravel affects $self;
    action rejectTravel affects $self;
  }

  validation validateCustomer on save { create; field CustomerID; }
  validation validateDates    on save { create; field BeginDate, EndDate; }

  mapping for ztravel_a
  {
    TravelUUID         = travel_uuid;
    TravelID           = travel_id;
    CustomerID         = customer_id;
    Description        = description;
    BeginDate          = begin_date;
    EndDate            = end_date;
    BookingFee         = booking_fee;
    TotalPrice         = total_price;
    CurrencyCode       = currency_code;
    OverallStatus      = overall_status;
    RejectReason       = reject_reason;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LastChangedBy      = last_changed_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}

define behavior for ZR_Booking alias Booking
persistent table zbooking_a
draft table zbooking_d
lock dependent by _Travel
authorization dependent by _Travel
etag master LocalLastChangedAt
{
  update;
  delete;
  association _Travel;

  field ( numbering : managed, readonly ) BookingUUID;
  field ( readonly ) TravelUUID, BookingID, LocalLastChangedAt;
  field ( mandatory ) CarrierID, FlightDate, FlightPrice;

  determination setBookingDefaults on modify { create; }
  determination calculateTotal     on modify { field FlightPrice, CurrencyCode; delete; }

  side effects
  {
    field FlightPrice affects field _Travel.TotalPrice;
    field CurrencyCode affects field _Travel.TotalPrice;
  }

  validation validateFlightDate on save { create; field FlightDate; }

  mapping for zbooking_a corresponding
  {
    BookingUUID        = booking_uuid;
    TravelUUID         = parent_uuid;
    BookingID          = booking_id;
    BookingDate        = booking_date;
    CarrierID          = carrier_id;
    FlightDate         = flight_date;
    FlightPrice        = flight_price;
    CurrencyCode       = currency_code;
    BookingStatus      = booking_status;
    LocalLastChangedAt = local_last_changed_at;
  }
}
