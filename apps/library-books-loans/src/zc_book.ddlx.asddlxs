@Metadata.layer: #CUSTOMER
@UI.headerInfo: { typeName: 'Book', typeNamePlural: 'Books',
                  title: { type: #STANDARD, value: 'Title' },
                  description: { value: 'Author' } }
@UI.presentationVariant: [{ sortOrder: [{ by: 'Title', direction: #ASC }] }]
annotate entity ZC_Book with
{
  @UI.facet: [ { id: 'General', purpose: #STANDARD, type: #COLLECTION,               label: 'General Information', position: 10 },
               { id: 'Book',    parentId: 'General', type: #IDENTIFICATION_REFERENCE, label: 'Book',        position: 10 },
               { id: 'Stock',   parentId: 'General', type: #FIELDGROUP_REFERENCE,     label: 'Availability', position: 20, targetQualifier: 'Stock' },
               { id: 'Loans',   purpose: #STANDARD, type: #LINEITEM_REFERENCE,        label: 'Loans',       position: 20, targetElement: '_Loan' },
               { id: 'Admin',   purpose: #STANDARD, type: #FIELDGROUP_REFERENCE,      label: 'Administrative Data', position: 30, targetQualifier: 'Admin' } ]
  @UI.hidden: true
  BookUUID;

  @UI: { lineItem:       [ { position: 10, importance: #HIGH } ],
         identification: [ { position: 10 } ],
         selectionField: [ { position: 10 } ] }
  @EndUserText.label: 'Title'
  Title;

  @UI: { lineItem:       [ { position: 20, importance: #HIGH } ],
         identification: [ { position: 20 } ],
         selectionField: [ { position: 20 } ] }
  @EndUserText.label: 'Author'
  Author;

  @UI: { lineItem:       [ { position: 30, importance: #MEDIUM } ],
         identification: [ { position: 30 } ] }
  @EndUserText.label: 'ISBN'
  ISBN;

  @UI: { lineItem:       [ { position: 40, importance: #MEDIUM } ],
         identification: [ { position: 40 } ],
         selectionField: [ { position: 30 } ] }
  @EndUserText.label: 'Genre'
  Genre;

  @UI: { lineItem:   [ { position: 50, importance: #HIGH } ],
         fieldGroup: [ { qualifier: 'Stock', position: 10 } ] }
  @EndUserText.label: 'Copies'
  Copies;

  @UI: { lineItem:   [ { position: 60, importance: #HIGH } ],
         fieldGroup: [ { qualifier: 'Stock', position: 20 } ] }
  @EndUserText.label: 'Open Loans'
  OpenLoans;

  @UI.fieldGroup: [ { qualifier: 'Admin', position: 10 } ]
  CreatedBy;
  @UI.fieldGroup: [ { qualifier: 'Admin', position: 20 } ]
  CreatedAt;
  @UI.fieldGroup: [ { qualifier: 'Admin', position: 30 } ]
  LastChangedAt;
  @UI.hidden: true
  LocalLastChangedAt;
}
