CLASS zcl_sale_report DEFINITION PUBLIC FINAL CREATE PUBLIC.
  PUBLIC SECTION.
    CLASS-METHODS visible RETURNING VALUE(rv_count) TYPE i.
    CLASS-METHODS all RETURNING VALUE(rv_count) TYPE i.
ENDCLASS.

CLASS zcl_sale_report IMPLEMENTATION.
  METHOD visible.
    SELECT COUNT(*) FROM zr_sale INTO @rv_count.
  ENDMETHOD.
  METHOD all.
    SELECT COUNT(*) FROM zr_sale WITH PRIVILEGED ACCESS INTO @rv_count.
  ENDMETHOD.
ENDCLASS.
