projection;
strict ( 2 );
use draft;

define behavior for ZC_Order alias Order
use etag
{
  use create;
  use update;
  use delete;
  use action release;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use association _Item { create; with draft; }
}

define behavior for ZC_OrderItem alias Item
{
  use update;
  use delete;
  use association _Order { with draft; }
}
