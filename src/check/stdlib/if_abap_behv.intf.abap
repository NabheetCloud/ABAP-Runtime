INTERFACE if_abap_behv PUBLIC.
  TYPES t_xflag TYPE c LENGTH 2.
  CONSTANTS:
    BEGIN OF mk,
      on  TYPE t_xflag VALUE '01',
      off TYPE t_xflag VALUE '00',
    END OF mk,
    BEGIN OF fc,
      BEGIN OF o,
        enabled  TYPE t_xflag VALUE '00',
        disabled TYPE t_xflag VALUE '01',
      END OF o,
      BEGIN OF f,
        unrestricted TYPE t_xflag VALUE '00',
        read_only    TYPE t_xflag VALUE '01',
        mandatory    TYPE t_xflag VALUE '02',
        all          TYPE t_xflag VALUE '00',
      END OF f,
    END OF fc,
    BEGIN OF auth,
      allowed      TYPE t_xflag VALUE '00',
      unauthorized TYPE t_xflag VALUE '01',
    END OF auth,
    BEGIN OF cause,
      not_found    TYPE t_xflag VALUE '01',
      unspecific   TYPE t_xflag VALUE '02',
      unauthorized TYPE t_xflag VALUE '03',
      locked       TYPE t_xflag VALUE '04',
      readonly     TYPE t_xflag VALUE '05',
      disabled     TYPE t_xflag VALUE '06',
      conflict     TYPE t_xflag VALUE '07',
      dependency   TYPE t_xflag VALUE '08',
    END OF cause.
ENDINTERFACE.
